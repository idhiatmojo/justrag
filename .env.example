# LLM API Keys
# Default LLM Provider: GEMINI
GEMINI_API_KEY=
# Alternative LLM Provider: OPENAI
OPENAI_API_KEY=
# xAI Grok Provider
XAI_API_KEY=

# Model Configuration
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-3-mini

# Embedding Configuration
# Options: gemini (gemini-embedding-001), local (BM25 + TF-IDF/SentenceTransformer), openai (text-embedding-3-small)
EMBEDDING_PROVIDER=local

# ChromaDB Storage Path
CHROMA_PERSIST_DIR=./data/chroma_db
BM25_PERSIST_DIR=./data/bm25_db
RAW_PDF_DIR=./data/raw_pdf
